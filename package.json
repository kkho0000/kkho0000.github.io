{
  "name": "personal-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-pages.mjs",
    "preview": "vite preview",
    "predeploy": "npm run check && npm run build",
    "deploy": "gh-pages -d dist --nojekyll",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run check:media",
    "images": "node scripts/optimize-images.mjs",
    "check:media": "node scripts/check-media.mjs"
  },
  "dependencies": {
    "marked": "^16.0.0",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "gh-pages": "^6.3.0",
    "sharp": "^0.35.4",
    "vite": "^7.0.0"
  }
}
